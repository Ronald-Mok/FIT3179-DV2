{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "C8 Marimekko chart: business size classes, 2024-25 (ABS). Column width = share of all businesses; column height is split into businesses that introduced an innovation, were still working on one (or abandoned it), and were not innovation-active. Same three groups and colours as the C2 waffle. Labels give the % innovation-active for each size.",
  "width": "container",
  "height": 340,
  "data": {
    "url": "data/innovation_status_2024-25.csv",
    "format": {
      "type": "csv",
      "parse": {
        "businesses_000": "number",
        "innovating": "number",
        "innovation_active": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.group !== 'All businesses'"
    },
    {
      "calculate": "indexof(['Micro (0–4 people)', 'Small (5–19 people)', 'Medium (20–199 people)', 'Large (200+ people)'], datum.group)",
      "as": "size_order"
    },
    {
      "calculate": "split(datum.group, ' ')[0]",
      "as": "size"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "businesses_000",
          "as": "all_businesses"
        }
      ]
    },
    {
      "calculate": "datum.businesses_000 / datum.all_businesses",
      "as": "width_share"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "width_share",
          "as": "x_end"
        }
      ],
      "sort": [
        {
          "field": "size_order"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.x_end - datum.width_share",
      "as": "x_start"
    },
    {
      "calculate": "(datum.x_start + datum.x_end) / 2",
      "as": "x_mid"
    },
    {
      "calculate": "datum.innovating",
      "as": "introduced"
    },
    {
      "calculate": "datum.innovation_active - datum.innovating",
      "as": "working"
    },
    {
      "calculate": "100 - datum.innovation_active",
      "as": "not_active"
    },
    {
      "fold": [
        "introduced",
        "working",
        "not_active"
      ],
      "as": [
        "status_key",
        "pct"
      ]
    },
    {
      "calculate": "indexof(['introduced', 'working', 'not_active'], datum.status_key)",
      "as": "status_order"
    },
    {
      "calculate": "['Introduced an innovation', 'Still working on one', 'Not innovation-active'][datum.status_order]",
      "as": "status"
    },
    {
      "window": [
        {
          "op": "sum",
          "field": "pct",
          "as": "y_end"
        }
      ],
      "groupby": [
        "group"
      ],
      "sort": [
        {
          "field": "status_order"
        }
      ],
      "frame": [
        null,
        0
      ]
    },
    {
      "calculate": "datum.y_end - datum.pct",
      "as": "y_start"
    },
    {
      "calculate": "datum.pct / 100",
      "as": "pct_share"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#ffffff",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x_start",
          "type": "quantitative",
          "title": "Share of all businesses (column width)",
          "scale": {
            "domain": [
              0,
              1.22
            ],
            "nice": false
          },
          "axis": {
            "format": ".0%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "grid": false
          }
        },
        "x2": {
          "field": "x_end"
        },
        "y": {
          "field": "y_start",
          "type": "quantitative",
          "title": "% of businesses in each size",
          "scale": {
            "domain": [
              0,
              100
            ],
            "nice": false
          },
          "axis": {
            "values": [
              0,
              25,
              50,
              75,
              100
            ],
            "labelExpr": "datum.label + '%'",
            "grid": false
          }
        },
        "y2": {
          "field": "y_end"
        },
        "color": {
          "field": "status",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Introduced an innovation",
              "Still working on one",
              "Not innovation-active"
            ],
            "range": [
              "#54278f",
              "#9e9ac8",
              "#e3e5e8"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "labelLimit": 200
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Business size"
          },
          {
            "field": "businesses_000",
            "title": "Businesses ('000)",
            "format": ","
          },
          {
            "field": "width_share",
            "title": "Share of all businesses",
            "format": ".1%"
          },
          {
            "field": "status",
            "title": "Group"
          },
          {
            "field": "pct_share",
            "title": "Share of businesses this size",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status_key === 'introduced' && datum.size_order <= 1"
        },
        {
          "calculate": "datum.size + ' · ' + format(datum.innovation_active, '.0f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1d2125"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "datum": 92
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status_key === 'introduced' && datum.size_order >= 2"
        },
        {
          "calculate": "datum.size + ' · ' + format(datum.innovation_active, '.0f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1d2125"
      },
      "encoding": {
        "x": {
          "datum": 1
        },
        "y": {
          "field": "innovation_active",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.status_key === 'not_active' && datum.size_order === 0"
        },
        {
          "calculate": "'Micro businesses are ' + format(datum.width_share, '.0%') + ' of all businesses'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#1d2125"
      },
      "encoding": {
        "x": {
          "field": "x_mid",
          "type": "quantitative"
        },
        "y": {
          "datum": 76
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
